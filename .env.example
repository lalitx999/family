# -------------------------------------------------------------
# Configuration for Family AI Butler
# -------------------------------------------------------------

# App Settings
APP_NAME="Family AI Butler"
APP_ENV="development"
DEBUG=true
SECRET_KEY="change_this_to_a_secure_random_key"

# Telegram Bot Settings
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_from_botfather"
TELEGRAM_GROUP_ID="-100xxxxxxxxxx"  # ID ของกลุ่มที่ดึงทั้ง คุณ + แฟน + บอท เข้าไป
USER_TELEGRAM_ID="123456789"         # Telegram ID ของคุณ (Freelancer)
PARTNER_TELEGRAM_ID="987654321"      # Telegram ID ของแฟน (Nurse)
TELEGRAM_WEBHOOK_URL="https://your-domain-or-tunnel.com/api/v1/webhook/telegram"

# AI API Keys
# 1. DeepSeek (สมองหลัก PM + วางแผนงาน + วิเคราะห์เหตุผล)
DEEPSEEK_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxx"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# 2. Groq (ความเร็ว + แปลงเสียงภาษาไทย Whisper)
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxx"
GROQ_MODEL="llama-3.3-70b-versatile"

# 3. Gemini (ดวงตาอ่านสลิปโอนเงิน + วางแผนเที่ยว)
GEMINI_API_KEY="AIzaxxxxxxxxxxxxxxxxxxxxxxxx"
GEMINI_MODEL="gemini-2.5-flash"

# Database & Cache (ค่าเริ่มต้นตรงกับ docker-compose.yml)
POSTGRES_USER="family_user"
POSTGRES_PASSWORD="family_password"
POSTGRES_DB="family_db"
POSTGRES_HOST="postgres"
POSTGRES_PORT=5432

DATABASE_URL="postgresql+asyncpg://family_user:family_password@postgres:5432/family_db"
SYNC_DATABASE_URL="postgresql://family_user:family_password@postgres:5432/family_db"

REDIS_URL="redis://redis:6379/0"
CELERY_BROKER_URL="redis://redis:6379/0"
CELERY_RESULT_BACKEND="redis://redis:6379/1"
